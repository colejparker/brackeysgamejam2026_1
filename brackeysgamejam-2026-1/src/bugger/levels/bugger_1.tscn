[node name="PopUp Menu" parent="." unique_id=1863548252 instance=ExtResource("21_6qsc3")]
visible = false
title_text = "Small Bug, Big World"
body_text = "As a small bug, you must navigate a world that is endlessly hostile to you in order to pick-up your furniture. The mini-map shows you your home's location, your location and the location of where you need to go to pick up your furniture. Along the way, avoid dangerous birds, bugs, thorns and water and pick-up leaves, nuts and even berries for more bugbucks."
