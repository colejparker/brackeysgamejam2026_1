visible = false
title_text = "Bugbook Marketplace"
body_text = "On Bugbook Marketplace, you can contact sellers to purchase furniture they no longer want to design your room. Clicking on the message button will indicate your interest in purchasing their item, and when you go out to meet them you'll need to travel to their home to pick-up your new furniture. You can close the menu without choosing to buy an item by clicking the X at the top-right."

